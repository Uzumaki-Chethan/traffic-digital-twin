<?xml version="1.0" encoding="UTF-8"?>
<!--
    default_view.xml
    ==================
    SUMO-GUI view settings, loaded via the gui settings file option
    (sumo-gui, option name gui-settings-file, pointing at
    default_view.xml). Real, documented sumo-gui functionality (View
    Settings dialog, Save), not an invented mechanism.

    Colors vehicles by vehicle CLASS, so car/motorcycle/bus/truck/
    emergency are all visually distinct at a glance, the natural
    default for a mixed-fleet smart city demo.

    Confidence note: this top-level structure matches what sumo-gui
    itself writes when you use its own View Settings -> Save dialog.
    If any attribute below fails to load on your version, save a
    settings file from the GUI once and diff against this file, that
    is the authoritative source for your exact installed version.
-->
<viewsettings>
    <scheme name="smart_city_default"/>
    <background backgroundColor="0.94,0.94,0.9" showGrid="0"/>
    <vehicles vehicleQuality="2" vehicleColorer="0" vehicleSize.exaggeration="1.2"/>
    <lanes laneColorer="0"/>
    <junctions junctionColorer="0"/>
</viewsettings>
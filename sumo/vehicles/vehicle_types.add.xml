<?xml version="1.0" encoding="UTF-8"?>
<!--
    vehicle_types.add.xml
    ======================
    Vehicle type definitions for the smart city demo environment.

    CORRECTED VERSION. The previous version used an invented
    "refId" attribute inside vTypeDistribution, which is not real
    SUMO syntax and caused a load failure. SUMO's actual documented
    pattern nests complete vType elements, each with a real id and a
    probability attribute, directly inside vTypeDistribution. That is
    what this file does.

    guiShape values used below (passenger, motorcycle, bus, truck,
    emergency, police, firebrigade) are used with high confidence,
    they appear consistently and repeatedly across SUMO's own
    documentation and examples. There is deliberately no "rickshaw"
    shape used here, that was asserted with unearned confidence
    previously, the auto rickshaw below instead reuses the motorcycle
    shape, differentiated by width, length, and colour rather than a
    dedicated shape this file cannot fully guarantee exists in your
    installed SUMO version.

    If any single vType below still fails to load, the authoritative,
    version-matched reference is the XSD schema shipped with your own
    SUMO install, typically at $SUMO_HOME/data/xsd/additional_file.xsd,
    please report the exact failing line and error rather than assume
    the whole file is wrong, so it can be fixed precisely.

    This file is loaded as a SUMO additional file alongside the frozen
    network, never as part of it. It is completely separate from the
    inline "car" vType already defined inside every ML-training
    scenario route file under sumo/routes/scenarios/, those files are
    frozen and untouched by this milestone.
-->
<additional>

    <!-- ===================== Passenger cars ===================== -->
    <!--
        Three sub-types nested directly inside the distribution, each a
        complete, independently valid vType definition with its own id
        and a probability attribute, this is the documented
        vTypeDistribution pattern, not a reference mechanism. Weights:
        20 percent cautious, 60 percent normal, 20 percent aggressive.
    -->
    <vTypeDistribution id="car">
        <vType id="car_cautious" vClass="passenger" guiShape="passenger"
               length="4.5" width="1.8" minGap="3.0"
               accel="2.0" decel="4.0" sigma="0.3" tau="1.3"
               maxSpeed="12.0" speedFactor="0.9" speedDev="0.05"
               color="0.85,0.85,0.9" probability="0.2"/>
        <vType id="car_normal" vClass="passenger" guiShape="passenger"
               length="4.5" width="1.8" minGap="2.5"
               accel="2.6" decel="4.5" sigma="0.5" tau="1.0"
               maxSpeed="13.89" speedFactor="1.0" speedDev="0.1"
               color="0.9,0.9,0.9" probability="0.6"/>
        <vType id="car_aggressive" vClass="passenger" guiShape="passenger"
               length="4.5" width="1.8" minGap="1.8"
               accel="3.2" decel="5.5" sigma="0.7" tau="0.8"
               maxSpeed="16.67" speedFactor="1.15" speedDev="0.1"
               color="0.7,0.15,0.15" probability="0.2"/>
    </vTypeDistribution>

    <!-- ===================== Motorcycles / scooters ===================== -->
    <!--
        Same nested-with-probability pattern as car above. Wider spread
        between cautious and aggressive sub-types than cars, reflecting
        the greater behavioural variance of real two-wheeler traffic.
    -->
    <vTypeDistribution id="motorcycle">
        <vType id="motorcycle_cautious" vClass="motorcycle" guiShape="motorcycle"
               length="2.0" width="0.7" minGap="1.2"
               accel="2.8" decel="4.5" sigma="0.4" tau="1.0"
               maxSpeed="13.89" speedFactor="0.95" speedDev="0.1"
               color="0.15,0.15,0.6" probability="0.25"/>
        <vType id="motorcycle_normal" vClass="motorcycle" guiShape="motorcycle"
               length="2.0" width="0.7" minGap="1.0"
               accel="3.5" decel="5.0" sigma="0.6" tau="0.8"
               maxSpeed="16.67" speedFactor="1.05" speedDev="0.15"
               color="0.2,0.2,0.8" probability="0.5"/>
        <vType id="motorcycle_aggressive" vClass="motorcycle" guiShape="motorcycle"
               length="2.0" width="0.7" minGap="0.6"
               accel="4.2" decel="6.0" sigma="0.85" tau="0.6"
               maxSpeed="19.44" speedFactor="1.2" speedDev="0.15"
               color="0.3,0.3,1.0" probability="0.25"/>
    </vTypeDistribution>

    <!-- ===================== Auto rickshaw ===================== -->
    <!--
        vClass approximated as motorcycle (closest real permission
        class, SUMO has no dedicated three-wheeler vClass). guiShape
        also reuses motorcycle, see the file header note on why a
        dedicated rickshaw shape is not used here. Visually
        differentiated from actual motorcycles by its wider body and
        the iconic yellow-black livery colour. Weak engine (low accel)
        and low realistic top speed, high sigma reflecting variable,
        often erratic real-world driving.
    -->
    <vType id="auto_rickshaw" vClass="motorcycle" guiShape="motorcycle"
           length="2.6" width="1.4" minGap="1.5"
           accel="1.8" decel="4.0" sigma="0.8" tau="1.1"
           maxSpeed="11.11" speedFactor="0.9" speedDev="0.15"
           color="1.0,0.8,0.0"/>

    <!-- ===================== Bus ===================== -->
    <!--
        Professional drivers on a fixed schedule, hence low sigma
        relative to private vehicles. Long, wide, slow to accelerate.
        Common state-transport orange livery.
    -->
    <vType id="bus" vClass="bus" guiShape="bus"
           length="10.5" width="2.5" minGap="3.0"
           accel="1.2" decel="3.5" sigma="0.3" tau="1.2"
           maxSpeed="12.5" speedFactor="1.0" speedDev="0.05"
           color="0.9,0.4,0.0"/>

    <!-- ===================== Truck ===================== -->
    <!--
        Heavy freight vehicle, slow acceleration and lower realistic top
        speed than passenger traffic, larger minGap reflecting both
        physical size and required following distance.
    -->
    <vType id="truck" vClass="truck" guiShape="truck"
           length="8.0" width="2.5" minGap="3.5"
           accel="1.0" decel="3.5" sigma="0.4" tau="1.4"
           maxSpeed="11.11" speedFactor="0.95" speedDev="0.05"
           color="0.3,0.45,0.3"/>

    <!-- ===================== Emergency vehicles ===================== -->
    <!--
        All three use vClass="emergency". Explicit note, unchanged from
        before: vClass="emergency" alone grants NO signal priority or
        special right-of-way in this simulation. Any priority behaviour
        is exclusively the future Decision Engine's responsibility, not
        implemented here. Low sigma across all three reflects trained,
        precise emergency driving.
    -->
    <vType id="ambulance" vClass="emergency" guiShape="emergency"
           length="5.5" width="2.0" minGap="2.0"
           accel="3.0" decel="6.0" sigma="0.2" tau="0.9"
           maxSpeed="19.44" speedFactor="1.0" speedDev="0.05"
           color="0.6,1.0,0.0"/>
    <vType id="police_vehicle" vClass="emergency" guiShape="police"
           length="4.8" width="1.9" minGap="2.0"
           accel="3.2" decel="6.0" sigma="0.2" tau="0.8"
           maxSpeed="22.22" speedFactor="1.0" speedDev="0.05"
           color="0.0,0.0,0.6"/>
    <vType id="fire_engine" vClass="emergency" guiShape="firebrigade"
           length="9.0" width="2.5" minGap="3.0"
           accel="1.5" decel="5.0" sigma="0.2" tau="1.0"
           maxSpeed="16.67" speedFactor="1.0" speedDev="0.05"
           color="1.0,0.0,0.0"/>

</additional>
<?xml version="1.0" encoding="UTF-8"?>
<!--
    vehicle_types_wet_weather.add.xml
    ===================================
    Rain approximation via genuine driving-parameter changes, not a
    fake "rain feature" (there is no such thing in SUMO). Every vType
    below is a distinct, "_wet"-suffixed copy of its counterpart in
    vehicle_types.add.xml (that file is left completely untouched -
    it is still loaded alongside this one, per the "every scenario
    must use vehicle_types.add.xml" rule, it's simply not the file the
    rain scenario's routes reference for movement).

    Three changes applied consistently, reflecting reduced tyre grip
    and driver caution on a wet road, roughly proportional to how
    exposed each vehicle class actually is:
      - maxSpeed lowered ~30-40% (drivers slow down in the rain)
      - sigma raised (less consistent, more cautious/erratic driving)
      - accel AND decel both lowered (less available grip in both
        directions, not just less willingness to speed - braking
        distance genuinely increases on a wet road, so decel drops
        too, not only accel)
      - tau (following gap) raised slightly, reflecting increased
        following distance in reduced-visibility, reduced-grip
        conditions

    Motorcycles and the auto-rickshaw get the largest relative
    reduction (two/three-wheelers lose proportionally more traction
    and stability in the wet than four-wheelers); the bus keeps the
    smallest sigma increase (professional drivers, still cautious but
    trained), matching the same reasoning already used for their base
    vTypes in vehicle_types.add.xml.
-->
<additional>
    <vType id="car_wet" vClass="passenger" guiShape="passenger"
           length="4.5" width="1.8" minGap="3.0"
           accel="1.8" decel="3.2" sigma="0.7" tau="1.3"
           maxSpeed="9.7" speedFactor="0.9" speedDev="0.1"
           color="0.6,0.65,0.75"/>

    <vType id="motorcycle_wet" vClass="motorcycle" guiShape="motorcycle"
           length="2.0" width="0.7" minGap="1.6"
           accel="2.2" decel="3.8" sigma="0.8" tau="1.1"
           maxSpeed="11.1" speedFactor="0.85" speedDev="0.15"
           color="0.2,0.25,0.55"/>

    <vType id="auto_rickshaw_wet" vClass="motorcycle" guiShape="motorcycle"
           length="2.6" width="1.4" minGap="1.8"
           accel="1.3" decel="3.0" sigma="0.9" tau="1.4"
           maxSpeed="7.8" speedFactor="0.85" speedDev="0.15"
           color="0.85,0.65,0.1"/>

    <vType id="bus_wet" vClass="bus" guiShape="bus"
           length="10.5" width="2.5" minGap="3.5"
           accel="0.9" decel="2.8" sigma="0.4" tau="1.5"
           maxSpeed="9.0" speedFactor="0.9" speedDev="0.05"
           color="0.75,0.35,0.0"/>

    <vType id="truck_wet" vClass="truck" guiShape="truck"
           length="8.0" width="2.5" minGap="4.0"
           accel="0.8" decel="2.6" sigma="0.5" tau="1.7"
           maxSpeed="8.0" speedFactor="0.9" speedDev="0.05"
           color="0.25,0.35,0.25"/>
</additional>
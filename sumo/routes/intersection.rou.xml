    <flow id="flow_W_N_car" type="car" route="route_W_N" begin="0" end="600" vehsPerHour="66.000"/>
    <flow id="flow_W_N_motorcycle" type="motorcycle" route="route_W_N" begin="0" end="600" vehsPerHour="36.000"/>
    <flow id="flow_W_N_auto_rickshaw" type="auto_rickshaw" route="route_W_N" begin="0" end="600" vehsPerHour="9.600"/>
    <flow id="flow_W_N_bus" type="bus" route="route_W_N" begin="0" end="600" vehsPerHour="4.800"/>
    <flow id="flow_W_N_truck" type="truck" route="route_W_N" begin="0" end="600" vehsPerHour="3.600"/>

    <flow id="flow_W_S_car" type="car" route="route_W_S" begin="0" end="600" vehsPerHour="66.000"/>
    <flow id="flow_W_S_motorcycle" type="motorcycle" route="route_W_S" begin="0" end="600" vehsPerHour="36.000"/>
    <flow id="flow_W_S_auto_rickshaw" type="auto_rickshaw" route="route_W_S" begin="0" end="600" vehsPerHour="9.600"/>
    <flow id="flow_W_S_bus" type="bus" route="route_W_S" begin="0" end="600" vehsPerHour="4.800"/>

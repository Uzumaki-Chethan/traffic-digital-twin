    <flow id="flow_S_E_auto_rickshaw" type="auto_rickshaw" route="route_S_E" begin="0" end="600" vehsPerHour="9.600"/>
    <flow id="flow_S_E_bus" type="bus" route="route_S_E" begin="0" end="600" vehsPerHour="4.800"/>
    <flow id="flow_S_E_truck" type="truck" route="route_S_E" begin="0" end="600" vehsPerHour="3.600"/>

    <flow id="flow_S_W_car" type="car" route="route_S_W" begin="0" end="600" vehsPerHour="66.000"/>
    <flow id="flow_S_W_motorcycle" type="motorcycle" route="route_S_W" begin="0" end="600" vehsPerHour="36.000"/>
    <flow id="flow_S_W_auto_rickshaw" type="auto_rickshaw" route="route_S_W" begin="0" end="600" vehsPerHour="9.600"/>
    <flow id="flow_S_W_bus" type="bus" route="route_S_W" begin="0" end="600" vehsPerHour="4.800"/>
    <flow id="flow_S_W_truck" type="truck" route="route_S_W" begin="0" end="600" vehsPerHour="3.600"/>

    <!-- EAST: 240 / 120 / 120 -->
    <flow id="flow_E_W_car" type="car" route="route_E_W" begin="0" end="600" vehsPerHour="132.000"/>
    <flow id="flow_E_W_motorcycle" type="motorcycle" route="route_E_W" begin="0" end="600" vehsPerHour="72.000"/>
    <flow id="flow_E_W_auto_rickshaw" type="auto_rickshaw" route="route_E_W" begin="0" end="600" vehsPerHour="19.200"/>
    <flow id="flow_E_W_bus" type="bus" route="route_E_W" begin="0" end="600" vehsPerHour="9.600"/>
    <flow id="flow_E_W_truck" type="truck" route="route_E_W" begin="0" end="600" vehsPerHour="7.200"/>

    <flow id="flow_E_N_car" type="car" route="route_E_N" begin="0" end="600" vehsPerHour="66.000"/>
    <flow id="flow_E_N_motorcycle" type="motorcycle" route="route_E_N" begin="0" end="600" vehsPerHour="36.000"/>
    <flow id="flow_E_N_auto_rickshaw" type="auto_rickshaw" route="route_E_N" begin="0" end="600" vehsPerHour="9.600"/>
    <flow id="flow_E_N_bus" type="bus" route="route_E_N" begin="0" end="600" vehsPerHour="4.800"/>
    <flow id="flow_E_N_truck" type="truck" route="route_E_N" begin="0" end="600" vehsPerHour="3.600"/>

    <flow id="flow_E_S_car" type="car" route="route_E_S" begin="0" end="600" vehsPerHour="66.000"/>
    <flow id="flow_E_S_motorcycle" type="motorcycle" route="route_E_S" begin="0" end="600" vehsPerHour="36.000"/>
    <flow id="flow_E_S_auto_rickshaw" type="auto_rickshaw" route="route_E_S" begin="0" end="600" vehsPerHour="9.600"/>
    <flow id="flow_E_S_bus" type="bus" route="route_E_S" begin="0" end="600" vehsPerHour="4.800"/>
    <flow id="flow_E_S_truck" type="truck" route="route_E_S" begin="0" end="600" vehsPerHour="3.600"/>

    <!-- WEST: 240 / 120 / 120 -->
    <flow id="flow_W_E_car" type="car" route="route_W_E" begin="0" end="600" vehsPerHour="132.000"/>
    <flow id="flow_W_E_motorcycle" type="motorcycle" route="route_W_E" begin="0" end="600" vehsPerHour="72.000"/>
    <flow id="flow_W_E_auto_rickshaw" type="auto_rickshaw" route="route_W_E" begin="0" end="600" vehsPerHour="19.200"/>

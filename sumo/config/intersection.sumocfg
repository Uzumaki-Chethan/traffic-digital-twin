<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <input>
        <net-file value="../network/intersection.net.xml"/>
        <route-files value="../routes/intersection.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="600"/>
         <step-length value="0.2"/>
    </time>

    <processing>
        <time-to-teleport value="-1"/>
    </processing>

    <report>
        <verbose value="true"/>
        <no-step-log value="true"/>
    </report>

    <gui_only>
        <gui-settings-file value=""/>
    </gui_only>

</configuration>